# LLM & Embedding API Keys
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini (FREE tier — used for Explainer, Quiz Gen, Evaluator agents)
# Get your free key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# LangSmith Observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT="medlearn-agent"

# Vision Model Configuration
CAPTIONER_MODEL="Salesforce/blip2-opt-2.7b"
USE_HF_LOCAL=true
MOCK_CAPTIONER=false

# Vector Database Path
VECTORSTORE_DIR="./app/vectorstore/chroma_db"
SOURCE_PDF_DIR="./data/source_pdfs"

# App Configuration
API_PORT=8000
FRONTEND_PORT=8501
